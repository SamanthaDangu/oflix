{% extends 'security/_auth_layout.html.twig' %}

{% block title %}Créer un compte | O'flix{% endblock %}

{% block auth_badge %}Bienvenue chez O'flix{% endblock %}
{% block auth_title %}Votre prochaine histoire commence ici.{% endblock %}
{% block auth_subtitle %}Créez votre compte pour garder vos découvertes à portée de main.{% endblock %}

{% block auth_content %}
    {{ form_start(registration_form, {attr: {class: 'auth-form'}}) }}
        {{ form_errors(registration_form) }}
        {{ form_row(registration_form.pseudo) }}
        {{ form_row(registration_form.email) }}
        {{ form_row(registration_form.plainPassword.first) }}
        <p class="form-hint">8 caractères minimum, avec une majuscule, une minuscule, un chiffre et un caractère spécial.</p>
        {{ form_row(registration_form.plainPassword.second) }}
        <button class="btn btn-danger w-100" type="submit">Créer mon compte</button>
        <p class="auth-form__foot">Vous avez déjà un compte ? <a href="{{ path('app_login') }}">Se connecter</a></p>
    {{ form_end(registration_form) }}
{% endblock %}
