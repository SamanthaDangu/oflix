{% extends 'back/back_base.html.twig' %}

{% block title %}{{ user.email }} | Back-office{% endblock %}

{% block title_admin %}Utilisateur{% endblock %}

{% block content %}
    <div class="admin-card">
        <div class="admin-card__head">
            <div>
                <h2 class="h5 mb-1">{{ user.pseudo ?: user.email }}</h2>
                <p class="text-muted mb-0">{{ user.email }} · {{ user.roles|join(', ') }}</p>
            </div>
            <div>
                <a href="{{ path('back_user_edit', {'id': user.id}) }}" class="btn btn-sm btn-outline-secondary">Modifier</a>
                {{ include('back/_delete_form.html.twig', {'delete_route': 'back_user_delete', 'entity_id': user.id}) }}
            </div>
        </div>
    </div>
{% endblock %}
