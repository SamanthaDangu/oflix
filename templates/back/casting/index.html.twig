{% extends 'back/back_base.html.twig' %}

{% block title %}Casting | Back-office{% endblock %}

{% block title_admin %}Casting{% endblock %}

{% block content %}
    <div class="admin-card">
        <div class="admin-card__head">
            <div>
                <h2 class="h5 mb-1">Castings</h2>
                <p class="text-muted mb-0">{{ castings|length }} attribution{{ castings|length > 1 ? 's' : '' }} de rôle.</p>
            </div>
            <a href="{{ path('back_casting_new') }}" class="btn btn-danger">Ajouter</a>
        </div>

        <div class="table-responsive">
            <table class="table admin-table">
                <thead>
                    <tr>
                        <th>Id</th>
                        <th>Rôle</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for casting in castings %}
                    <tr>
                        <td>{{ casting.id }}</td>
                        <td>{{ casting.role }}</td>
                        <td class="text-end">
                            <a href="{{ path('back_casting_show', {'id': casting.id}) }}" class="btn btn-sm btn-outline-danger">Voir</a>
                            <a href="{{ path('back_casting_edit', {'id': casting.id}) }}" class="btn btn-sm btn-outline-secondary">Modifier</a>
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="3" class="text-muted text-center py-4">Aucun casting trouvé.</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
