{% extends 'back/back_base.html.twig' %}

{% block title %}Casting | Back-office{% endblock %}

{% block title_admin %}Casting{% endblock %}

{% block content %}
    <div class="admin-card">
        <div class="admin-card__head">
            <div>
                <h2 class="h5 mb-1">{{ casting.role }}</h2>
                <p class="text-muted mb-0">{{ casting.actor.firstname }} {{ casting.actor.lastname }} — {{ casting.movie.title }}</p>
            </div>
            <div>
                <a href="{{ path('back_casting_edit', {'id': casting.id}) }}" class="btn btn-sm btn-outline-secondary">Modifier</a>
                {{ include('back/_delete_form.html.twig', {'delete_route': 'back_casting_delete', 'entity_id': casting.id}) }}
            </div>
        </div>
    </div>
{% endblock %}
