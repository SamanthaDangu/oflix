{% extends 'back/back_base.html.twig' %}

{% block title %}Films et séries | Back-office{% endblock %}

{% block title_admin %}Films et séries{% endblock %}

{% block content %}
    {% for message in app.flashes('notice-jb') %}
        <div class="alert alert-success" role="status">{{ message }}</div>
    {% endfor %}
    {% for message in app.flashes('error') %}
        <div class="alert alert-danger" role="alert">{{ message }}</div>
    {% endfor %}

    <div class="admin-card">
        <div class="admin-card__head">
            <div>
                <h2 class="h5 mb-1">Catalogue</h2>
                <p class="text-muted mb-0">{{ movies|length }} programme{{ movies|length > 1 ? 's' : '' }} en base.</p>
            </div>
            <a href="{{ path('back_movie_new') }}" class="btn btn-danger">Ajouter</a>
        </div>

        <div class="table-responsive">
            <table class="table admin-table">
                <thead>
                    <tr>
                        <th>Id</th>
                        <th>Titre</th>
                        <th>Sortie</th>
                        <th>Type</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for movie in movies %}
                    <tr>
                        <td>{{ movie.id }}</td>
                        <td>{{ movie.title }}</td>
                        <td>{{ movie.releaseDate ? movie.releaseDate|date('d/m/Y') : '' }}</td>
                        <td>{{ movie.type }}</td>
                        <td class="text-end">
                            <a href="{{ path('back_movie_show', {'id': movie.id}) }}" class="btn btn-sm btn-outline-danger">Voir</a>
                            <a href="{{ path('back_movie_edit', {'id': movie.id}) }}" class="btn btn-sm btn-outline-secondary">Modifier</a>
                            <a href="{{ path('back_casting_index_by_movie', {'id': movie.id}) }}" class="btn btn-sm btn-outline-warning">Casting</a>
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="5" class="text-muted text-center py-4">Aucun programme trouvé.</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
