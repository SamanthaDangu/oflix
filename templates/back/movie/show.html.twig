{% extends 'back/back_base.html.twig' %}

{% block title %}{{ movie.title }} | Back-office{% endblock %}

{% block title_admin %}Film{% endblock %}

{% block content %}
    <div class="admin-card">
        <div class="admin-card__head">
            <div>
                <h2 class="h5 mb-1">{{ movie.title }}</h2>
                <p class="text-muted mb-0">{{ movie.type }} · {{ movie.duration }} min · {{ movie.releaseDate ? movie.releaseDate|date('d/m/Y') : '' }}</p>
            </div>
            <div>
                <a href="{{ path('back_movie_edit', {'id': movie.id}) }}" class="btn btn-sm btn-outline-secondary">Modifier</a>
                <a href="{{ path('back_casting_index_by_movie', {'id': movie.id}) }}" class="btn btn-sm btn-outline-warning">Casting</a>
                {{ include('back/movie/_delete_form.html.twig') }}
            </div>
        </div>

        <div class="row g-4">
            <div class="col-md-4">
                <img src="{{ movie.poster }}" alt="{{ movie.title }}" class="img-fluid rounded">
            </div>
            <div class="col-md-8">
                <dl class="row">
                    <dt class="col-sm-3">Résumé</dt>
                    <dd class="col-sm-9">{{ movie.summary }}</dd>
                    <dt class="col-sm-3">Synopsis</dt>
                    <dd class="col-sm-9">{{ movie.synopsis }}</dd>
                    <dt class="col-sm-3">Note</dt>
                    <dd class="col-sm-9">{{ movie.rating|default('NC') }}/5</dd>
                </dl>
            </div>
        </div>
    </div>
{% endblock %}
