{% extends 'base.html.twig' %}

{% block title %}Accès refusé | O'flix{% endblock %}

{% block body %}
<section class="page-section error-page">
    <div class="container-xl text-center">
        <span class="error-page__code">403</span>
        <h1>Séance réservée.</h1>
        <p class="lead">Vous n'avez pas accès à cette page avec votre compte actuel.</p>
        <div class="d-flex flex-wrap justify-content-center gap-2">
            <a href="{{ path('movie_home') }}" class="btn btn-outline-danger"><i class="bi bi-house-door"></i> Retour à l'accueil</a>
            {% if not app.user %}
                <a href="{{ path('app_login') }}" class="btn btn-danger"><i class="bi bi-box-arrow-in-right"></i> Se connecter</a>
            {% endif %}
        </div>
    </div>
</section>
{% endblock %}
