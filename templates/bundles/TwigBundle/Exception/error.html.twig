{% extends 'base.html.twig' %}

{% block title %}Erreur {{ status_code }} | O'flix{% endblock %}

{% block body %}
<section class="page-section error-page">
    <div class="container-xl text-center">
        <span class="error-page__code">{{ status_code }}</span>
        <h1>Un imprévu de diffusion.</h1>
        <p class="lead">Une erreur est survenue. Merci de réessayer dans quelques instants.</p>
        <a href="{{ path('movie_home') }}" class="btn btn-danger"><i class="bi bi-house-door"></i> Retour à l'accueil</a>
    </div>
</section>
{% endblock %}
