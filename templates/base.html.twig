<!doctype html>
<html lang="fr">

    <head>
        <!-- Required meta tags -->
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="description" content="{% block meta_description %}O'flix vous aide à choisir vos prochains films et séries grâce à un catalogue de recommandations, fiches détaillées et avis de spectateurs.{% endblock %}">
        <meta name="robots" content="{% block meta_robots %}index,follow{% endblock %}">
        <link rel="canonical" href="{% block canonical_url %}{{ app.request.schemeAndHttpHost }}{{ app.request.pathInfo }}{% endblock %}">
        <meta property="og:site_name" content="O'flix">
        <meta property="og:type" content="{% block og_type %}website{% endblock %}">
        <meta property="og:title" content="{% block og_title %}{{ block('title') }}{% endblock %}">
        <meta property="og:description" content="{% block og_description %}{{ block('meta_description') }}{% endblock %}">
        <meta property="og:url" content="{{ block('canonical_url') }}">
        <meta property="og:image" content="{% block og_image %}{{ absolute_url(asset('assets/favicon.png')) }}{% endblock %}">
        <meta name="twitter:card" content="summary_large_image">

        <!-- Bootstrap CSS -->
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.1/dist/css/bootstrap.min.css" rel="stylesheet"
            integrity="sha384-F3w7mX95PdgyTmZZMECAngseQB83DfGTowi0iMjiWaeVhAn4FJkqJByhZMI3AhiU" crossorigin="anonymous">
        <!-- Bootstrap icons -->
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.5.0/font/bootstrap-icons.css">

        <!-- Our custom CSS -->
        <link rel="stylesheet" href="{{ asset('assets/css/oflix.css') }}">
        <!-- favicon -->
        
        {# https://symfony.com/doc/current/templates.html#linking-to-css-javascript-and-image-assets #}
        {# the image lives at "public/images/logo.png" #}
        {# <img src="{{ asset('images/logo.png') }}" alt="Symfony!"/> #}
        <link rel="shortcut icon" href="{{ asset('assets/favicon.png') }}" type="image/x-icon">

        <title>{% block title %}Bienvenue sur O'flix{% endblock %}</title>
        {# Run `composer require symfony/webpack-encore-bundle` to start using Symfony UX #}
        
    </head>
    <body class="app-shell app-shell--{{ app.session.get('theme', 'netflix') }}">
    <nav class="navbar navbar-expand-lg navbar-dark site-nav">
        <div class="container-xl">
            <a href="{{ path('movie_home') }}" class="d-flex align-items-center text-decoration-none header-logo">
                <img src="{{ asset('assets/favicon.png') }}" height="24" alt="Logo O'flix">
                <span class="header-logo__title">O'flix</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                data-bs-target="#navbarSupportedContent">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarSupportedContent">
                <ul class="navbar-nav me-auto mb-3 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('movie_home') }}"><i class="bi bi-house-door"></i> Accueil</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('catalogue') }}"><i class="bi bi-grid-3x3-gap"></i> Catalogue</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('films') }}"><i class="bi bi-film"></i> Films</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('series') }}"><i class="bi bi-tv"></i> Séries</a>
                    </li>
                    {% if app.user %}
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('main_favorites') }}"><i class="bi bi-bookmark"></i> Ma liste</a>
                        </li>
                    {% endif %}
                </ul>
                {% if app.user != null %}
                    <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown" role="button"
                                data-bs-toggle="dropdown">
                                <span>{{ app.user.displayName }} ( {{ app.user.displayRole }} ) </span>
                                <i class="bi bi-person-square"></i>
                            </a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" href="{{ path('app_profile') }}"><i class="bi bi-person-circle"></i> Profil</a></li>
                                {% if is_granted('ROLE_MANAGER') %}
                                    <li><a class="dropdown-item" href="{{ path('back_movie_index') }}"><i class="bi bi-gear"></i> Backoffice</a></li>
                                {% endif %}
                                <li>
                                    <hr class="dropdown-divider">
                                </li>
                                <li><a class="dropdown-item" href="{{ path('app_logout')}}"><i class="bi bi-box-arrow-right"></i> Déconnexion</a></li>
                            </ul>
                        </li>
                    </ul>
                {% else %}
                    <a href="{{ path('app_register') }}" class="btn btn-link text-light me-2">Créer un compte</a>
                    <a href="{{ path('app_login')}}" class="btn btn-danger me-2">Connexion</a>
                {% endif %}

                <form class="site-search" action="{{ path('catalogue') }}" method="get" role="search">
                    <label class="visually-hidden" for="site-search-input">Rechercher un film ou une série</label>
                    <input id="site-search-input" class="form-control" name="search" type="search" placeholder="Rechercher..." value="{{ app.request.query.get('search', '') }}">
                    <button class="btn btn-outline-danger" type="submit" aria-label="Lancer la recherche"><i class="bi bi-search"></i></button>
                </form>
            </div>
        </div>
    </nav>
    <div id="broadcast_message" class="container-xl">
        {% for message in app.flashes('success') %}
            <div class="alert alert-success mt-3" role="status">{{ message }}</div>
        {% endfor %}
        {% for message in app.flashes('error') %}
            <div class="alert alert-danger mt-3" role="alert">{{ message }}</div>
        {% endfor %}
    </div>
    <main class="site-main">
        {% block admin_nav %}{% endblock %}
        {% block body %}{% endblock %}
    </main>
    {% if randomMovie is defined %}
        <div class="random-movie container-xl">
            <span>À découvrir au hasard</span>
            <a href="{{ path('movie', {slug: randomMovie.slug}) }}">{{ randomMovie.title }}</a>
        </div>
    {% endif %}
    <footer class="site-footer">
        <div class="container-xl d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2">
            <span>O'flix, une sélection pour vos prochaines séances.</span>
            <small>Thème :</small>
                <form action="{{ path('main_theme_switcher')}}" method="post" class="d-inline">
                    <input type="hidden" name="_token" value="{{ csrf_token('theme_switcher') }}">
                    <button type="submit" class="theme-switch text-decoration-none btn btn-link btn-sm p-0 align-baseline">
                    {# Attention avec la session, bien vérifier ce qui se passe la première fois qu'on arrive sur le site #}
                    {% if app.session.get('theme', 'netflix') == 'netflix' %}
                    Allociné <i class="bi bi-toggle-on mx-1"></i> Netflix
                    {% else %}
                    Allociné <i class="bi bi-toggle-off mx-1"></i> Netflix
                    {% endif %}    
                    </button>
                </form>
        </div>
    </footer>

    <!-- Optional JavaScript; choose one of 
        the two! -->

    <!-- Option 1: Bootstrap Bundle with Popper -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.1/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-/bQdsTh/da6pkI1MST/rWKFNjaCP5gBSY4sEBT38Q/9RBh9AH40zEOg7Hlq2THRZ"
        crossorigin="anonymous"></script>

    <!-- Option 2: Separate Popper and Bootstrap JS -->
    <!--
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.9.3/dist/umd/popper.min.js" integrity="sha384-W8fXfP3gkOKtndU4JGtKDvXbO53Wy8SZCQHczT5FMiiqmQfUpWbYdTil/SxwZgAN" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.1/dist/js/bootstrap.min.js" integrity="sha384-skAcpIdS7UcVUC05LJ9Dxay8AXcDYfBJqt1CJ85S/CFujBsIzCIv+l9liuYLaMQ/" crossorigin="anonymous"></script>
    -->
</body>
</html>
