{% extends "base.html.twig" %}

{% block title %}Ma liste | O'flix{% endblock %}

{% block body %}

<section class="page-section page-section--tinted">
    <div class="container-xl">
        <div class="section-heading">
            <span class="movie-card__type">Votre sélection</span>
            <h1>Ma liste</h1>
            <p>{{ favoriteMovies|length }} programme{{ favoriteMovies|length > 1 ? 's' : '' }} enregistré{{ favoriteMovies|length > 1 ? 's' : '' }}.</p>
        </div>
        <div class="row g-4">
            {% for movie in favoriteMovies %}
                <div class="col-12 col-md-6 col-xl-4">
                    <article class="row g-0 movie-card flex-md-row h-100 position-relative">
                        <div class="col-4 movie__poster movie-card__poster" style="background-image: url('{{ movie.poster|e('html_attr') }}');">
                            <img src="{{ movie.poster }}" alt="Affiche de {{ movie.title }}" loading="lazy">
                        </div>
                        <div class="col-8 movie-card__content">
                            <span class="movie-card__type">{{ movie.type|movieTypeLabel }}</span>
                            <h2 class="h5 mt-2">{{ movie.title }}</h2>
                            <div class="movie-card__meta">{{ movie.duration ? movie.duration ~ ' min' : 'Durée non communiquée' }}</div>
                            <div class="movie-card__meta rating mt-2"><i class="bi bi-star-fill"></i> {{ movie.rating|default('NC') }}<span>/5</span></div>
                            <div class="d-flex gap-2 mt-3">
                                <a href="{{ path('movie', {slug: movie.slug}) }}" class="btn btn-sm btn-outline-danger">Voir</a>
                                <form method="post" action="{{ path('movie_favorite_remove', {slug: movie.slug}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('favorite_' ~ movie.id) }}">
                                    <button class="btn btn-sm btn-outline-secondary" type="submit">Retirer</button>
                                </form>
                            </div>
                        </div>
                    </article>
                </div>
            {% else %}
                <div class="empty-state">
                    <i class="bi bi-bookmark-heart"></i>
                    <h2>Votre liste est vide</h2>
                    <p>Ajoutez les films et séries que vous voulez garder sous la main.</p>
                    <a href="{{ path('movie_home') }}" class="btn btn-danger">Explorer le catalogue</a>
                </div>
            {% endfor %}
        </div>
    </div>
</section>


{% endblock %}
