{% extends "base.html.twig" %}

{% block title %}O'flix - {{ movie.title }}{% endblock %}
{% block meta_description %}{{ movie.summary|striptags|slice(0, 155) }}{% endblock %}
{% block og_type %}video.movie{% endblock %}
{% block og_title %}{{ movie.title }} | O'flix{% endblock %}
{% block og_image %}{{ movie.poster }}{% endblock %}

{% block body %}
<!-- main -->

    {% set genreNames = [] %}
    {% for genre in movie.genres %}
        {% set genreNames = genreNames|merge([genre.name]) %}
    {% endfor %}
    {% set jsonLd = {
        '@context': 'https://schema.org',
        '@type': 'Movie',
        'name': movie.title,
        'image': movie.poster,
        'description': movie.summary|striptags,
        'genre': genreNames,
        'duration': 'PT' ~ movie.duration ~ 'M',
    } %}
    {% if movie.releaseDate %}
        {% set jsonLd = jsonLd|merge({'dateCreated': movie.releaseDate|date('Y-m-d')}) %}
    {% endif %}
    {% if movie.rating and reviews is not empty %}
        {% set jsonLd = jsonLd|merge({'aggregateRating': {
            '@type': 'AggregateRating',
            'ratingValue': movie.rating,
            'bestRating': 5,
            'ratingCount': reviews|length,
        }}) %}
    {% endif %}
    <script type="application/ld+json">{{ jsonLd|json_encode|raw }}</script>

    <section class="page-section">
    <div class="container-xl">

        <div class="row mb-2">

            <div class="col">

                <div class="row g-0 movie-detail flex-md-row align-items-start mb-4 position-relative">
                    <div class="col-12 col-md-4 movie__poster movie-detail__poster"
                        style="background-image: url('{{ movie.poster|e('html_attr') }}');">
                        <img src="{{ movie.poster }}" alt="Affiche de {{ movie.title }}" class="img-fluid">
                    </div>

                    <div class="col-12 col-md-8 d-flex flex-column position-static movie-detail__content">
                        {% if app.user %}
                            {% if app.user.hasFavoriteMovie(movie) %}
                                <form method="post" action="{{ path('movie_favorite_remove', {slug: movie.slug}) }}" class="movie__favorite">
                                    <input type="hidden" name="_token" value="{{ csrf_token('favorite_' ~ movie.id) }}">
                                    <button type="submit" class="btn btn-link p-0 fs-4" aria-label="Retirer {{ movie.title }} de ma liste"><i class="bi bi-bookmark-check-fill"></i></button>
                                </form>
                            {% else %}
                                <form method="post" action="{{ path('movie_favorite_add', {slug: movie.slug}) }}" class="movie__favorite">
                                    <input type="hidden" name="_token" value="{{ csrf_token('favorite_' ~ movie.id) }}">
                                    <button type="submit" class="btn btn-link p-0 fs-4" aria-label="Ajouter {{ movie.title }} à ma liste"><i class="bi bi-bookmark-plus"></i></button>
                                </form>
                            {% endif %}
                        {% else %}
                            <a href="{{ path('app_login') }}" class="movie__favorite" aria-label="Connectez-vous pour ajouter {{ movie.title }} à ma liste"><i class="bi bi-bookmark-plus"></i></a>
                        {% endif %}
                        <span class="movie-card__type mb-2">{{ movie.type }}</span>
                        <h1 class="mb-2">{{ movie.title }}</h1>
                        <div class="movie-card__meta mb-3">{{ movie.duration }} min</div>
                        <p>
                            {% for genre in movie.genres %}
                                <span class="badge bg-warning text-dark">{{ genre.name }}</span>
                            {% endfor %}
                        </p>
                        <p>{{ movie.summary }}</p>
                        <div class="d-flex rating">
                        {% for i in range(0, 4) %}
                            {% set starClass = movie.rating - i >= 1 ? '-fill' : (movie.rating - i >= 0.5 ? '-half' : '') %}
                            <span class="bi bi-star{{ starClass }}"></span>
                        {% endfor %}
                            <span class="ps-1">{{ movie.rating }}</span>
                        </div>

                        <h2>{{ movie.seasons|length }} Saisons</h2>
                        <ul class="list-unstyled">
                            {% for season in movie.seasons %}
                                <li><span class="badge bg-danger fs-6 mb-2">Saison {{ season.number }}</span> <small class="ms-1">({{ season.episodesNumber }} épisodes)</small></li>
                            {% endfor %}
                            
                        </ul>

                        <dl class="row">
                            <dt class="col-sm-12">Avec</dt>
                            <dd class="col-sm-12">
                                {% for casting in castings %}
                                    {{ casting.actor.firstname }} {{ casting.actor.lastname }} ({{ casting.role }})<br>
                                {% else %}
                                    <em>pas d'acteurs</em><br>
                                {% endfor %}
                            </dd>
                            <dt class="col-sm-12">Pays</dt>
                            <dd class="col-sm-12">USA</dd>
                            <dt class="col-sm-12">Année</dt>
                            {# https://twig.symfony.com/doc/2.x/filters/date.html #}
                            <dd class="col-sm-12">{{movie.releaseDate|date("d/m/Y")}}</dd>
                        </dl>

                    </div>
                </div>

            </div>
            <div class="col-12">
                <div class="section-heading mt-4">
                    <span class="movie-card__type">Avis des spectateurs</span>
                    {% if reviews is not empty %}
                        <h2>{{ reviews|length }} critique{{ reviews|length > 1 ? 's' : '' }}</h2>
                    {% endif %}
                </div>

                {% if userReview %}
                    <div class="d-flex gap-2 mb-2">
                        <a class="btn btn-sm btn-outline-danger" href="{{ path('movie_review_add', {id: movie.id}) }}"><i class="bi bi-pencil"></i> Modifier ma critique</a>
                        <form method="post" action="{{ path('movie_review_delete', {id: movie.id}) }}" onsubmit="return confirm('Supprimer définitivement votre critique ?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete_review_' ~ userReview.id) }}">
                            <button class="btn btn-sm btn-outline-secondary" type="submit"><i class="bi bi-trash"></i> Supprimer</button>
                        </form>
                    </div>
                {% else %}
                    <p><a class="btn btn-sm btn-danger" href="{{ path('movie_review_add', {id: movie.id}) }}">Ajouter une critique</a></p>
                {% endif %}

                {% if reviews is empty %}
                    <div class="empty-state">
                        <i class="bi bi-chat-square-text"></i>
                        <h2>Aucune critique pour l'instant</h2>
                        <p>Soyez le premier ou la première à partager votre avis sur ce film.</p>
                    </div>
                {% else %}
                    <div class="row g-3">
                        {% for review in reviews %}
                            <div class="col-12 col-md-6">
                                <div class="card border-0 h-100">
                                    <div class="card-body">
                                        {% if review.rating > 0 %}
                                            <div class="d-flex rating">
                                                {% set k = review.rating %}
                                                {% for i in range(1, review.rating|round(0, 'floor')) %}
                                                    <i class="bi bi-star-fill"></i>
                                                    {% set k = k - 1 %}
                                                {% endfor %}
                                                {% if k > 0 %}
                                                    <i class="bi bi-star-half"></i>
                                                {% endif %}
                                                <span class="ps-1">{{ review.rating }}</span>
                                            </div>
                                        {% endif %}
                                        <h6 class="card-subtitle my-2 text-muted">de {{ review.username }} vu le {{ review.watchedAt|date('d/m/y') }}</h6>
                                        <p class="card-text">{{ review.content }}</p>
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% endif %}
            </div>

        </div>

    </div>
    </section>
{% endblock %}
