{% extends 'base.html.twig' %}

{% block title %}Support | O'flix{% endblock %}

{% block body %}
<section class="page-section">
<div class="container-xl">
    <div class="auth-panel">
        <div class="auth-panel__intro">
            <span class="movie-card__type">Centre d'aide</span>
            <h1>Besoin d'un coup de main ?</h1>
            <p>Une question sur votre compte ou votre expérience O'flix ? Nous sommes là pour vous répondre.</p>
        </div>
        <div class="auth-form">
            <h2 class="h4 mb-3">Support O'flix</h2>
            <p class="text-muted">Notre équipe vous accompagne pour profiter pleinement du catalogue.</p>
            <a class="btn btn-danger mt-3" href="mailto:support@oflix.test">Nous contacter</a>
        </div>
    </div>
</div>
</section>

{% endblock %}
