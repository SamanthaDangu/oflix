{% extends 'base.html.twig' %}

{% block title %}{{ genre.name }} | O'flix{% endblock %}
{% block meta_description %}Découvrez les films et séries du genre {{ genre.name }} disponibles dans le catalogue O'flix.{% endblock %}

{% import 'front/movie/_grid_card.html.twig' as grid %}

{% block body %}
<section class="genre-page genre-page--detail">
    <div class="container-xl">
        <div class="genre-hero genre-hero--detail">
            <span class="genre-kicker">Collection</span>
            <h1>{{ genre.name }}</h1>
            <p>{{ genre.movies|length }} programme{{ genre.movies|length > 1 ? 's' : '' }} associé{{ genre.movies|length > 1 ? 's' : '' }} à ce genre.</p>
        </div>

        {% if genre.movies is not empty %}
            <div class="genre-film-grid">
                {% for movie in genre.movies %}
                    {{ grid.card(movie) }}
                {% endfor %}
            </div>
        {% else %}
            <div class="empty-state">
                <i class="bi bi-film"></i>
                <h2>Aucun film dans cette collection</h2>
            </div>
        {% endif %}
    </div>
</section>
{% endblock %}
